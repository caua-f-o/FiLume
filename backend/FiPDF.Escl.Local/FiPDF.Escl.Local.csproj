<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Servidor eSCL só para este computador, derivado do NAPS2.Escl.Server (LGPL-2.1-or-later).
    Fica numa DLL separada (FiPDF.Escl.Local.dll), como pede a LGPL, e mantém a licença de origem.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>FiPDF.Escl.Local</AssemblyName>
    <RootNamespace>FiPDF.Escl.Local</RootNamespace>
    <Version>0.1.0</Version>
    <Description>Servidor eSCL local (127.0.0.1) do FiPDF, derivado do NAPS2.Escl.Server.</Description>
    <Copyright>NAPS2 Contributors; modificações Cauã F. O. — LGPL-2.1-or-later</Copyright>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Diagnostics" />
    <Using Include="System.Xml.Linq" />
    <Using Include="NAPS2.Escl" />
    <Using Include="NAPS2.Escl.Server" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAPS2.Escl" Version="1.5.0" />
    <!-- Para o LocalScanJob (digitalização pelo WIA/TWAIN). -->
    <PackageReference Include="NAPS2.Sdk" Version="1.5.0" />
    <!-- A mesma versão que o NAPS2.Escl.Server usa. -->
    <PackageReference Include="EmbedIO" Version="3.5.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" Link="LICENSE-FiPDF.Escl.Local.txt" />
  </ItemGroup>

</Project>
